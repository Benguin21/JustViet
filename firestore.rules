    function topCreateOk(postId, d) {
      let pa = get(postPath(postId)).data;
      let pb = getAfter(postPath(postId)).data;
      return textOk(d.body, 1, RESPONSE_MAX()) && d.mention == null
        && pb.responses == pa.responses + 1 && pb.erased == pa.erased;
    }
    // One reply level: a reply's parent is a top-level response that isn't deleted.
    function replyCreateOk(postId, d) {
      let ra = get(respPath(postId, d.parent)).data;
      let rb = getAfter(respPath(postId, d.parent)).data;
      return textOk(d.body, 1, REPLY_MAX()) && (d.mention == null || d.mention is string)
        && ra.parent == null && ra.deleted == false && rb.replies == ra.replies + 1;
    }
    function respUpdateOk(postId, rid) {
      let a = resource.data;
      let b = request.resource.data;
      let changed = b.diff(a).affectedKeys();
      return (a.author == me() && a.deleted == false
              && (respEditOk(a, b, changed) || respEraseOk(postId, rid, a, b, changed)))
        || (isMod() && respModOk(postId, rid, a, b, changed))
        || (isMod() && a.parent == null && itemVoidOk(postId, rid, a, b, changed))
        || replyCountOk(postId, rid, a, b, changed)
        || (a.parent == null && itemVoteOk(postId, rid, a, b, changed));
    }
    function respEditOk(a, b, changed) {
      return changed.hasOnly(['body', 'editedAt']) && b.editedAt == request.time
        && textOk(b.body, 1, a.parent == null ? RESPONSE_MAX() : REPLY_MAX())
        && notSuspendedNow()
        && linksOkFor(get(profilePath(me())).data, b.body);
    }
    // A moderator removes or restores an answer, comment or reply (replies carry no votes).
    function respModOk(postId, rid, a, b, changed) {
      return changed.hasOnly(['body', 'deleted', 'removed'])
        && ((a.deleted == false && b.deleted == true && b.removed == true && b.body == ''
              && acted('remove', postId + '/' + rid)
              && removedCopyMatches('r_' + postId + '_' + rid, a)
              && (a.parent != null || authorCountsMove(a.author, 0 - a.up, 0 - a.down)))
          || (a.get('removed', false) == true && b.deleted == false && b.removed == false
              && acted('restore', postId + '/' + rid)
              && restoredFromCopy('r_' + postId + '_' + rid, b)
              && (a.parent != null || authorCountsMove(a.author, a.up, a.down))));
    }
    // A top-level response with replies is erased (text and author gone for good) so its replies stay.
    function respEraseOk(postId, rid, a, b, changed) {
      return a.parent == null && a.replies > 0
        && changed.hasOnly(['body', 'author', 'deleted', 'up', 'down', 'score'])
        && b.body == '' && b.author == '' && b.deleted == true && b.up == 0 && b.down == 0 && b.score == 0
        && ownCountsDropBy(a.up, a.down)
        && acted('delete', postId + '/' + rid)
        && postLosesTop(postId, rid, 1);
    }
    function respDeleteOk(postId, rid) {
      let a = resource.data;
      return a.author == me() && a.deleted == false
        && acted('delete', postId + '/' + rid)
        && (a.parent == null
            ? (a.replies == 0 && ownCountsDropBy(a.up, a.down) && postLosesTop(postId, rid, 0))
            : replyParentDrops(postId, a.parent));
    }
    // The post's count drops by one, and acceptance clears if it was this answer.
    function postLosesTop(postId, rid, erasedDelta) {
      let pa = get(postPath(postId)).data;
      let pb = getAfter(postPath(postId)).data;
      return pb.responses == pa.responses - 1 && pb.erased == pa.erased + erasedDelta
        && pb.accepted == (pa.accepted == rid ? null : pa.accepted);
    }
    function replyParentDrops(postId, parent) {
      let ra = get(respPath(postId, parent)).data;
      let rb = getAfter(respPath(postId, parent)).data;
      return rb.replies == ra.replies - 1;
    }
    // A top-level response's reply count moves by exactly one reply added or deleted in this request.
    function replyCountOk(postId, rid, a, b, changed) {
      let x = getAfter(activityPath(me())).data;
      let parts = x.target.split('/');
      return x.at == request.time && parts.size() == 2 && parts[0] == postId && parts[1] != rid
        && changed.hasOnly(['replies'])
        && replyChangeOk(postId, rid, parts[1], x.act, a, b);
    }
    function replyChangeOk(postId, parent, child, kind, a, b) {
      let path = respPath(postId, child);
      return (kind == 'respond' && !exists(path) && getAfter(path).data.parent == parent && b.replies == a.replies + 1)
        || (kind == 'delete' && get(path).data.parent == parent && !existsAfter(path) && b.replies == a.replies - 1);
    }

    // ----- communityVotes/{voteId}: one per item and voter, private to the voter -----
    match /communityVotes/{voteId} {
      // Only ids ending in your own uid: probing someone else's vote is refused whether it exists or not.
      // Moderators can see votes to investigate manipulation.
      allow get: if (member() && voteId.split('_')[voteId.split('_').size() - 1] == me()) || isMod();
      allow list: if (member() && resource.data.voter == me()) || isMod();
      allow create, update: if member() && voteOk(voteId);
      allow update: if member() && isMod() && voidOk(voteId);
    }
    // A moderator cancels someone else's vote (to 0), moving the item's and author's counts back.
    function voidOk(voteId) {
      let a = resource.data;
      let v = request.resource.data;
      return v.diff(a).affectedKeys().hasOnly(['value', 'at']) && v.value == 0 && a.value != 0
        && v.at == request.time && a.voter != me()
        && acted('void', voteId)
        && voteItemOk(v, a.value) && voteAuthorOk(v, a.value);
    }
    function voteOk(voteId) {
      let v = request.resource.data;
      let before = resource == null ? 0 : resource.data.value;
      let x = getAfter(activityPath(me())).data;
      return v.keys().hasOnly(['voter', 'post', 'response', 'author', 'value', 'at'])
        && v.keys().hasAll(['voter', 'post', 'response', 'author', 'value', 'at'])
        && v.voter == me() && v.at == request.time
        && v.value in [-1, 0, 1] && v.value != before
        && voteId == voteIdFor(v.post, v.response, me())
        && (resource == null
            || (resource.data.post == v.post && resource.data.response == v.response && resource.data.author == v.author))
        && x.at == request.time && x.target == voteId
        && ((x.act == 'vote' && x.lastVote == request.time && notSuspended(x))
            // Withdrawing your own vote while deleting your account: no wait, and allowed even if suspended.
            || (x.act == 'leave' && v.value == 0))
        && voteItemOk(v, before)
        && voteAuthorOk(v, before);
    }
    // Not your own, not deleted, not a reply; and its counts move by exactly this vote.
    function voteItemOk(v, before) {
      let ia = get(itemPath(v.post, v.response)).data;
      let ib = getAfter(itemPath(v.post, v.response)).data;
      return ia.deleted == false && ib.deleted == false
        && ia.author == v.author && v.author != me()
        && (v.response == null || ia.parent == null)
        && ib.up == ia.up + upD(before, v.value)
        && ib.down == ia.down + downD(before, v.value);
    }
    // The author's Community XP moves by the same amount.
    function voteAuthorOk(v, before) {
      let pa = get(profilePath(v.author)).data;
      let pb = getAfter(profilePath(v.author)).data;
      return pb.up == pa.up + upD(before, v.value) && pb.down == pa.down + downD(before, v.value);
    }

    // ----- communityReports/{id}: one per item and reporter; the moderation queue -----
    match /communityReports/{reportId} {
      allow get: if (member() && reportId.split('_')[0] == me()) || isMod();
      allow list: if (member() && resource.data.reporter == me()) || isMod();
      allow create: if member() && reportOk(reportId);
      // Moderators close reports (they never delete them).
      allow update: if isMod()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedAt'])
        && request.resource.data.status in ['actioned', 'dismissed']
        && request.resource.data.resolvedAt == request.time;
    }
    function reportOk(reportId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['reporter', 'kind', 'post', 'response', 'profile', 'reason', 'note', 'at', 'status'])
        && d.keys().hasAll(['reporter', 'kind', 'post', 'response', 'profile', 'reason', 'note', 'at', 'status'])
        && d.reporter == me() && d.at == request.time && d.status == 'open'
        && d.reason in REASONS() && d.note is string && d.note.size() <= REPORT_NOTE_MAX()
        && reportTargetOk(reportId, d)
        && acted('report', reportId)
        && notSuspended(getAfter(activityPath(me())).data);
    }
    function reportTargetOk(reportId, d) {
      return (d.kind == 'post' && d.response == null && d.profile == null
              && reportId == me() + '_p_' + d.post && exists(postPath(d.post)))
        || (d.kind in ['response', 'reply'] && d.profile == null
              && reportId == me() + '_r_' + d.post + '_' + d.response
              && (get(respPath(d.post, d.response)).data.parent == null) == (d.kind == 'response'))
        || (d.kind == 'profile' && d.post == null && d.response == null && d.profile != me()
              && reportId == me() + '_u_' + d.profile && exists(profilePath(d.profile)));
    }

    // ----- a member's own responses across all posts (deleting an account finds them this way) -----
    match /{path=**}/responses/{rid} {
      allow list: if member() && resource.data.author == me();
    }

    // ----- communityRemoved/{p_post | r_post_response}: a removed item's text, so it can be restored -----
    match /communityRemoved/{key} {
      allow get: if isMod() || (verified() && resource.data.author == me());
      allow list: if isMod() || (verified() && resource.data.author == me());
      allow create: if isMod() && removedCreateOk(key);
      // A moderator deletes it on restore; its author may delete it for good (then it can't be restored).
      allow delete: if isMod() || (verified() && resource.data.author == me());
    }
    function removedCreateOk(key) {
      let d = request.resource.data;
      let parts = key.split('_');
      return d.keys().hasOnly(['author', 'post', 'response', 'title', 'body', 'reason', 'removedAt'])
        && d.keys().hasAll(['author', 'post', 'response', 'title', 'body', 'reason', 'removedAt'])
        && d.removedAt == request.time && d.reason is string && d.reason.size() <= MOD_REASON_MAX()
        && ((parts.size() == 2 && parts[0] == 'p' && d.post == parts[1] && d.response == null)
            || (parts.size() == 3 && parts[0] == 'r' && d.post == parts[1] && d.response == parts[2]))
        && removedCopyOfOk(d, get(itemPath(d.post, d.response)).data);
    }
    function removedCopyOfOk(d, item) {
      return item.deleted == false && d.author == item.author && d.body == item.body && d.title == item.get('title', '');
    }

    // ----- communityModLog/{id}: every moderator action, for moderators only -----
    match /communityModLog/{id} {
      allow get, list: if isMod();
      allow create: if isMod() && modLogOk();
    }
    function modLogOk() {
      let d = request.resource.data;
      return d.keys().hasOnly(['by', 'action', 'uid', 'post', 'response', 'reason', 'until', 'at'])
        && d.keys().hasAll(['by', 'action', 'uid', 'post', 'response', 'reason', 'until', 'at'])
        && d.by == me() && d.at == request.time && d.action in MOD_ACTIONS()
        && d.reason is string && d.reason.size() <= MOD_REASON_MAX()
        && (d.until == null || d.until is timestamp);
    }

    // ----- communityInbox/{uid}/notifications/{id}: written by whoever caused them, read by the owner -----
    match /communityInbox/{uid}/notifications/{nid} {
      // Readable even when banned, so a banned member can see why.
      allow get, list, delete: if verified() && uid == me();
      allow update: if (verified() && uid == me()
                         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
                         && request.resource.data.read == true)
                    || (verified() && uid != me() && notifyOk(uid, nid));
      allow create: if verified() && uid != me() && notifyOk(uid, nid);
    }
    function notifyOk(uid, nid) {
      let n = request.resource.data;
      return n.keys().hasOnly(['type', 'from', 'post', 'response', 'reason', 'until', 'at', 'read'])
        && n.keys().hasAll(['type', 'from', 'post', 'response', 'reason', 'until', 'at', 'read'])
        && n.at == request.time && n.read == false
        && ((n.type in MOD_NOTIFICATIONS() && isMod() && n.from == 'mod'
              && nid.matches('^mod_[A-Za-z0-9]{16,40}$')
              && n.reason is string && n.reason.size() <= MOD_REASON_MAX()
              && (n.until == null || n.until is timestamp))
          || (n.from == me() && n.reason == '' && n.until == null
              && n.type in ['response', 'reply', 'mention', 'accepted']
              && n.post is string && n.response is string
              && nid == n.type + '_' + n.post + '_' + n.response
              && (n.type == 'accepted' ? acceptedNotifyOk(uid, n) : respondNotifyOk(uid, n))));
    }
    // The answer, comment or reply was written by the sender in this very request, to this recipient.
    function respondNotifyOk(uid, n) {
      let r = getAfter(respPath(n.post, n.response)).data;
      return acted('respond', n.post + '/' + n.response) && r.author == me()
        && ((n.type == 'response' && r.parent == null && get(postPath(n.post)).data.author == uid)
            || (n.type == 'reply' && r.parent != null && getAfter(respPath(n.post, string(r.parent))).data.author == uid)
            || (n.type == 'mention' && r.parent != null && r.mention == uid));
    }
    // The asker accepted this recipient's answer in this very request.
    function acceptedNotifyOk(uid, n) {
      let p = getAfter(postPath(n.post)).data;
      return p.author == me() && p.accepted == n.response
        && get(postPath(n.post)).data.accepted != n.response
        && getAfter(respPath(n.post, n.response)).data.author == uid;
    }
  }
}
